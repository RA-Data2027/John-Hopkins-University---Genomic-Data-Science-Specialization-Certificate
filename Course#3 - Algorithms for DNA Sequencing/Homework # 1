# --------------------------------------------------
# Display codons in a reading frame
# --------------------------------------------------

def show_codons(sequence, frame):
    offset = frame - 1

    for i in range(offset, len(sequence) - 2, 3):
        codon = sequence[i:i + 3]
        print("Position:", i + 1, "Codon:", codon)


print("\nTesting reading frame 1:")
show_codons("ATGCCCTAG", 1)


# --------------------------------------------------
# Find complete forward ORFs
# Positions are 1-based and include the stop codon.
# --------------------------------------------------

def find_orfs(sequence, frame):
    if frame not in (1, 2, 3):
        raise ValueError("Frame must be 1, 2, or 3.")

    sequence = str(sequence).upper()
    stop_codons = {"TAA", "TAG", "TGA"}
    pending_starts = []
    orfs = []

    for i in range(frame - 1, len(sequence) - 2, 3):
        codon = sequence[i:i + 3]

        if codon == "ATG":
            pending_starts.append(i)

        elif codon in stop_codons:
            for start in pending_starts:
                orfs.append({
                    "start": start + 1,
                    "end": i + 3,
                    "length": i + 3 - start,
                })

            pending_starts.clear()

    return orfs


print("\nORF tests:")

print("Complete ORF:")
print(find_orfs("ATGCCCTAG", 1))

print("No stop codon:")
print(find_orfs("ATGAAAAAA", 1))

print("Two start codons before one stop:")
print(find_orfs("ATGATGTAA", 1))

print("\nFrame 2 test:")
print(find_orfs("AATGCCCTAG", 2))

print("\nFrame 3 test:")
print(find_orfs("AAATGCCCTAG", 3))


# --------------------------------------------------
# Collect and report ORFs
# --------------------------------------------------

def collect_orfs(records, frame):
    all_orfs = []

    for record in records:
        sequence_orfs = find_orfs(record.seq, frame)

        for orf in sequence_orfs:
            all_orfs.append({
                "id": record.id,
                "frame": frame,
                **orf,
            })

    return all_orfs


def print_longest_orfs(orfs):
    if not orfs:
        print("No complete ORFs found.")
        return

    longest_length = max(orf["length"] for orf in orfs)

    print("Longest ORF length:", longest_length)

    for orf in orfs:
        if orf["length"] == longest_length:
            print("Sequence identifier:", orf["id"])
            print("Reading frame:", orf["frame"])
            print("Start position:", orf["start"])
            print("End position:", orf["end"])
            print()


