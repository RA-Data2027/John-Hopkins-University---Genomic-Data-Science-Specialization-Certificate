summarize_repeats(practice_counts)

print("\nTied repeats practice test:")
practice_counts = count_repeats(["AAAA", "CCCC"], 3)
summarize_repeats(practice_counts)

print("\nNo repeats practice test:")
practice_counts = count_repeats(["ACGT"], 3)
summarize_repeats(practice_counts)


