print(count_repeats(["ACACA"], 3))

print("AAAAA, length 3:")
print(count_repeats(["AAAAA"], 3))

print("Two separate sequences, length 3:")
print(count_repeats(["AA", "AA"], 3))


# --------------------------------------------------
# Summarize repeated substrings
# --------------------------------------------------

def summarize_repeats(counts):
    repeats = {
        substring: count
        for substring, count in counts.items()
        if count > 1
    }

    if not repeats:
        print("No repeats found.")
        return

    highest_count = max(repeats.values())

    print("Number of distinct repeated substrings:", len(repeats))
    print("Highest occurrence count:", highest_count)
    print("Most frequent repeat(s):")

    for substring, count in sorted(repeats.items()):
        if count == highest_count:
            print(substring, count)


