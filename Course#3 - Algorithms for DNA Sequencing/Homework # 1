# --------------------------------------------------
# Count overlapping substrings
# Sequences are counted separately, not joined together.
# --------------------------------------------------

def count_repeats(sequences, n):
    if n <= 0:
        raise ValueError("Repeat length must be greater than zero.")

    counts = {}

    for sequence in sequences:
        sequence = str(sequence).upper()

        for i in range(len(sequence) - n + 1):
            substring = sequence[i:i + n]
            counts[substring] = counts.get(substring, 0) + 1

    return counts


