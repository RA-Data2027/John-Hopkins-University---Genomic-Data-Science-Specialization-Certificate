# --------------------------------------------------
# Analyze a sequence selected by its full identifier
# --------------------------------------------------

def report_sequence_orfs(records, sequence_id, frame):
    matching_records = [
        record for record in records
        if record.id == sequence_id
    ]

    if not matching_records:
        print("Sequence identifier not found:", sequence_id)
        return

    if len(matching_records) > 1:
        print("Multiple records have this identifier:", sequence_id)
        return

    sequence_orfs = collect_orfs(matching_records, frame)

    print("\nSelected sequence:", sequence_id)
    print("Requested reading frame:", frame)
    print_longest_orfs(sequence_orfs)


