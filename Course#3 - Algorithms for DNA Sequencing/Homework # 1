# --------------------------------------------------
# Print all repeated substrings
# --------------------------------------------------

def print_all_repeats(counts):
    repeats = [
        (substring, count)
        for substring, count in counts.items()
        if count > 1
    ]

    if not repeats:
        print("No repeats found.")
        return

    for substring, count in sorted(
        repeats,
        key=lambda item: (-item[1], item[0]),
    ):
        print(substring, count)


