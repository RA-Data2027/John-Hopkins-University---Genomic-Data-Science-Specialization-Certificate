# --------------------------------------------------
# Read the FASTA file
# --------------------------------------------------

def read_fasta(filename):
    """Read a FASTA file and return its records."""
    with open(filename) as handle:
        records = list(SeqIO.parse(handle, "fasta"))

    return records


