    total_index_hits = 0
    all_matches = set()
    
    # Pre-build index with k = 8 and ival = 3 inside the function as requested
    index = SubseqIndex(t, 8, 3) 
    
    # Check the 3 non-overlapping subsequence partitions (offsets 0, 1, 2)
    for start in range(3):
        # Slicing the pattern automatically isolates the corresponding shifted subsequence
        matches = index.query(p[start:])
        total_index_hits += len(matches)
        
        for m in matches:
            text_offset = m - start
            if text_offset < 0 or (text_offset + len(p)) > len(t):
