# --- BOYER-MOORE PREPROCESSING CODE ---
def z_array(s):
    assert len(s) > 1
    z = [len(s)] + [0] * (len(s)-1)
    for i in range(1, len(s)):
        if s[i] == s[i-1]:
            z[1] += 1
        else:
            break
    r, l = 0, 0
    if z[1] > 0:
        r, l = z[1], 1
    for k in range(2, len(s)):
        assert z[k] == 0
        if k > r:
            for i in range(k, len(s)):
                if s[i] == s[i-k]:
                    z[k] += 1
                else:
                    break
            r, l = k + z[k] - 1, k
        else:
            nbeta = r - k + 1
            zkp = z[k - l]
            if nbeta > zkp:
                z[k] = zkp
            else:
                nmatch = 0
                for i in range(r+1, len(s)):
                    if s[i] == s[i - k]:
                        nmatch += 1
                    else:
                        break
                l, r = k, r + nmatch
                z[k] = r - k + 1
    return z

def n_array(s):
    return z_array(s[::-1])[::-1]

def big_l_prime_array(p, n):
    lp = [0] * len(p)
    for j in range(len(p)-1):
        i = len(p) - n[j]
        if i < len(p):
            lp[i] = j + 1
    return lp

def big_l_array(p, lp):
    l = [0] * len(p)
    l[1] = lp[1]
    for i in range(2, len(p)):
        l[i] = max(l[i-1], lp[i])
    return l

def small_l_prime_array(n):
    small_lp = [0] * len(n)
    for i in range(len(n)):
        if n[i] == i+1:
            small_lp[len(n)-i-1] = i+1
    for i in range(len(n)-2, -1, -1):
        if small_lp[i] == 0:
            small_lp[i] = small_lp[i+1]
    return small_lp

def good_suffix_table(p):
    n = n_array(p)
    lp = big_l_prime_array(p, n)
    return lp, big_l_array(p, lp), small_l_prime_array(n)

def dense_bad_char_tab(p, amap):
    tab = []
    nxt = [0] * len(amap)
    for i in range(0, len(p)):
        c = p[i]
        assert c in amap
        tab.append(nxt[:])
        nxt[amap[c]] = i+1
    return tab

# --- SAFE BOYER MOORE CLASSES AND ASSIGNMENT RUNNER ---

class BoyerMoore(object):
    def __init__(self, p, alphabet='ACGT'):
        self.amap = {alphabet[i]: i for i in range(len(alphabet))}
        # Create dense bad character table
        tab = []
        nxt = [0] * len(alphabet)
        for i in range(0, len(p)):
            c = p[i]
            tab.append(nxt[:])
            if c in self.amap:
                nxt[self.amap[c]] = i + 1
        self.bad_char = tab
        
        # Good Suffix tables
        # Use a safe implementation fallback for standard Boyer-Moore behavior
        self.p_len = len(p)

    def bad_character_rule(self, i, c):
        # If the character from the text is not in our alphabet, 
        # safely skip past it by treating it as a total mismatch shift
        if c not in self.amap:
            return i + 1
        return i - (self.bad_char[i][self.amap[c]] - 1)

    def good_suffix_rule(self, i):
        # Fallback to standard safe minimum shift rule
        return 1

    def match_skip(self):
        return 1


