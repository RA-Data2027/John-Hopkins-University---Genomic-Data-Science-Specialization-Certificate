def approximate_match_index(p, t, index, max_mismatches=2):
    segment_length = 8  # 24-length pattern divided into 3 chunks of length 8
    all_matches = set()
    total_index_hits = 0
    
    # Loop over each of the 3 chunks
    for i in range(3):
        start = i * segment_length
        end = start + segment_length
        kmer = p[start:end]
        
        # Look up this exact segment chunk in our 8-mer index
        hits = index.query(kmer)
        
        for hit in hits:
            total_index_hits += 1
            # Backtrack to find where the full pattern should align in text T
            text_start = hit - start
            
            # Boundary check
            if text_start < 0 or text_start + len(p) > len(t):
                continue
                
            # Verify substitutions character-by-character
            mismatches = 0
            for j in range(len(p)):
                if t[text_start + j] != p[j]:
                    mismatches += 1
                    if mismatches > max_mismatches:
                        break
                        
            # Set structure prevents counting a single valid match multiple times
            if mismatches <= max_mismatches:
                all_matches.add(text_start)
                
    return sorted(list(all_matches)), total_index_hits


